      "dependsOn": ["build-release", "update-snapshot-rollback"]
    },
    {
      "id": "runbook-publicar-release",
      "title": "Runbook de publicação",
      "kind": "runbook",
      "l0": "Checklist humano para revisar o draft, provar integridade e recuperação e publicar uma release estável sem dados de usuário.",
      "l1": "docs/context/runbooks/publicar-release.md",
      "l2": [
        "build.ps1"
      ],
      "tags": ["github", "publicacao", "release", "runbook"],
      "criticality": "high",
      "dependsOn": ["build-release"]
