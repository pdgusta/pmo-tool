        "tests/fixtures/migrations/schema-v3.json",
        "tests/fixtures/migrations/schema-v4.json"
      ],
      "tags": ["bundle", "migracao", "modelo", "schema"],
      "criticality": "critical",
      "dependsOn": []
    },
    {
      "id": "persistencia-hibrida",
      "title": "Persistência híbrida",
      "kind": "domain",
      "l0": "Coordena o bundle em memória, IndexedDB e réplica em disco, escolhe a cópia mais recente e concentra mutações. Falhas devem ser visíveis e nunca destruir a última cópia válida.",
      "l1": "docs/context/persistencia-hibrida.md",
      "l2": [
        "src/js/20-store.js",
        "serve.ps1",
        "tools/portable-common.ps1",
        "tests/Run-Tests.ps1",
        "tests/Invoke-ServerIntegration.ps1"
      ],
      "tags": ["disco", "indexeddb", "persistencia", "store"],
      "criticality": "critical",
      "dependsOn": ["modelo-schema"]
    },
    {
      "id": "anexos",
      "title": "Cofre de anexos",
      "kind": "domain",
      "l0": "Separa metadados do bundle e blobs armazenados no IndexedDB ou disco. Update, backup e restauração só são seguros após conferir presença, tamanho e hash de cada blob.",
      "l1": "docs/context/anexos.md",
      "l2": [
        "src/js/20-store.js",
        "src/js/66-views-dados.js",
        "serve.ps1"
      ],
      "tags": ["anexos", "blobs", "cofre", "integridade"],
      "criticality": "critical",
      "dependsOn": ["persistencia-hibrida"]
    },
    {
      "id": "importacao-reconciliacao",
      "title": "Importação e reconciliação",
      "kind": "domain",
      "l0": "Converte arquivos externos em candidatos, calcula diferenças e só aplica campos aprovados via Store. Parsers não podem sobrescrever o portfólio diretamente nem prometer conteúdo que não leem.",
      "l1": "docs/context/importacao-reconciliacao.md",
      "l2": [
        "src/js/30-import.js",
        "src/js/66-views-dados.js"
      ],
      "tags": ["diff", "importacao", "parsers", "reconciliacao"],
      "criticality": "high",
      "dependsOn": ["modelo-schema", "persistencia-hibrida", "anexos"]
    },
    {
      "id": "auditoria-retencao",
      "title": "Auditoria e retenção",
      "kind": "domain",
      "l0": "Registra mutações e histórico de importações como dados do usuário. A arquitetura portátil deve preservar esses registros e tornar qualquer política de retenção explícita e não destrutiva.",
      "l1": "docs/context/auditoria-retencao.md",
      "l2": [
        "src/js/20-store.js",
        "src/js/30-import.js",
        "src/js/70-views-config.js"
      ],
      "tags": ["auditoria", "historico", "retencao", "undo"],
      "criticality": "high",
      "dependsOn": ["persistencia-hibrida"]
    },
    {
      "id": "runtime-portatil",
      "title": "Runtime portátil",
      "kind": "domain",
      "l0": "Mantém versões imutáveis do código separadas de dados, configuração, estado e logs persistentes. O launcher seleciona a versão ativa e conserva a origem localhost:8090.",
