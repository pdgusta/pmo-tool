      "criticality": "critical",
      "dependsOn": ["update-snapshot-rollback"]
    },
    {
      "id": "operacao-recuperacao",
      "title": "Operação e recuperação",
      "kind": "domain",
      "l0": "Orienta operação da máquina B, diagnóstico, preservação de evidências e recuperação segura. Incidentes nunca autorizam apagar staging, snapshots ou dados antes de uma cópia forense.",
      "l1": "docs/context/operacao-recuperacao.md",
      "l2": [
        "docs/context/runbooks/incidente-maquina-b.md"
