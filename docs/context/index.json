      "tags": ["bootstrap", "launcher", "portabilidade", "runtime"],
      "criticality": "critical",
      "dependsOn": ["persistencia-hibrida", "anexos"]
    },
    {
      "id": "update-snapshot-rollback",
      "title": "Update, snapshot e rollback",
      "kind": "domain",
      "l0": "Define atualização transacional em staging, snapshot completo e ativação por ponteiro. Qualquer falha mantém a versão anterior e os dados intactos; rollback de schema exige snapshot compatível.",
      "l1": "docs/context/update-snapshot-rollback.md",
      "l2": [
        "atualizar.ps1",
        "tools/update-runtime.ps1",
        "tests/Test-UpdaterRecovery.ps1",
        "tests/Run-Tests.ps1",
        "tests/Invoke-ServerIntegration.ps1",
        "docs/context/runbooks/atualizar-maquina-b.md",
        "docs/context/runbooks/rollback-restauracao.md"
      ],
      "tags": ["rollback", "snapshot", "transacao", "update"],
      "criticality": "critical",
      "dependsOn": ["runtime-portatil", "auditoria-retencao"]
    },
    {
      "id": "build-release",
      "title": "Build e release",
      "kind": "domain",
      "l0": "Produz o HTML autocontido e o pacote de runtime, associa versão, commit e hashes e publica somente após gates. Artefatos de release jamais contêm diretórios persistentes.",
      "l1": "docs/context/build-release.md",
      "l2": [
        "build.ps1",
