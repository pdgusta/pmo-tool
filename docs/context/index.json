    {
      "id": "protocolo-contexto",
      "title": "Protocolo de contexto L0/L1/L2",
      "kind": "protocol",
      "l0": "Define como agentes descobrem domínios pelo índice, avançam de L0 para L1 e L2, interpretam estado atual versus alvo e validam relações sem carregar o repositório inteiro.",
      "l1": "docs/context/README.md",
      "l2": [
        "tools/validar-contexto.ps1"
      ],
      "tags": ["agentes", "contexto", "documentacao"],
      "criticality": "high",
      "dependsOn": []
    },
    {
      "id": "modelo-schema",
      "title": "Modelo e evolução de schema",
      "kind": "domain",
      "l0": "Define o bundle canônico, entidades, versões e migrações. Toda leitura ou escrita persistente depende deste contrato e deve rejeitar schema futuro sem alterar dados.",
